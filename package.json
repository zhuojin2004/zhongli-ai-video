    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@lark-apaas/coding-preset-vite-react": "^1.0.20",
    "@lark-apaas/coding-presets-react": "^0.1.0",
    "@lark-apaas/fullstack-presets": "^1.1.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.20",
    "@types/express": "^5.0.3",
    "@types/hbs": "^4.0.5",
    "@types/node": "^22.18.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
