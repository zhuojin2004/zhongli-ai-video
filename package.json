    "stylelint": "^16.11.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9",
    "vite": "^8"
  },
  "actionPlugins": {
    "@official-plugins/ai-text-to-image": "1.0.21",
    "@official-plugins/ai-text-generate": "1.0.21",
    "@official-plugins/ai-speech-synthesis": "1.0.13",
    "@official-plugins/ai-search-summary": "1.0.13",
    "@official-plugins/web-crawler": "1.0.10"
  }
}
