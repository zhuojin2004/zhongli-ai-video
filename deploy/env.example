# ================================================
# 中力视频生产平台 - 服务器环境变量模板
# ================================================
# 复制为 .env 后填入真实值，部署脚本会自动 cp .env.example .env
# ⚠️  此文件已包含在 .gitignore，请勿 commit

# ── 服务端口（一般不需要改）──────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# ── FFmpeg 路径（mockApiServer 抽帧 / 切片依赖）──
# deploy.sh 自动追加：FFMPEG_PATH=/usr/bin/ffmpeg
FFMPEG_PATH=/usr/bin/ffmpeg

# ── 视频文件存储路径 ─────────────────────────
VIDEO_UPLOAD_DIR=/opt/zhongli/uploads

# ── 飞书多维表格（视频库主表 / 分镜表 / 账号表）──
FEISHU_APP_ID=<your-feishu-app-id>
FEISHU_APP_SECRET=<your-feishu-app-secret>
FEISHU_BITABLE_APP_TOKEN=<your-bitable-app-token>
FEISHU_TABLE_ID=<shot-table-id>
FEISHU_MAIN_TABLE_ID=<main-video-table-id>
FEISHU_NEW_VIDEO_TABLE_ID=tbly8R5zwud22O58
FEISHU_USER_TABLE_ID=tblEwFfTWRzrvBy4
FEISHU_BASE=https://open.feishu.cn

# ── MiniMax（视频 AI 解析 / 打标，可选）────────
MINIMAX_API_KEY=<your-minimax-api-key>
MINIMAX_BASE=https://api.MiniMax.com/v1

# ── 豆包 TTS（火山引擎，可选）─────────────────
DOUBAO_CLIENT_ID=<your-doubao-client-id>
DOUBAO_CLIENT_SECRET=<your-doubao-client-secret>
DOUBAO_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v1/mt_tts

# ── 阿里云 OSS（视频云端存储，可选）────────────
ALI_OSS_ACCESS_KEY_ID=<your-access-key-id>
ALI_OSS_ACCESS_KEY_SECRET=<your-access-key-secret>
ALI_OSS_BUCKET=<your-bucket-name>
ALI_OSS_REGION=<oss-region>
ALI_OSS_ENDPOINT=<oss-endpoint>
ALI_OSS_PREFIX=zhongli/
ALI_OSS_PUBLIC_READ=true

# ── 日志（一般不需要改）───────────────────────
LOG_DIR=/opt/zhongli/logs
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false