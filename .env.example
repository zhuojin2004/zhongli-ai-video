# ================================================
# 重力视频素材库 - 环境变量模板
# ================================================
# ⚠️ 这是模板文件，可以安全提交到 git
# ⚠️ 复制为 .env 后填入真实值（.env 已被 .gitignore 排除）
# ⚠️ Railway 部署时，这些值在 Railway Dashboard 设置，不要 commit 到 git

# ── 日志 ──────────────────────────────────────
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# ── MiniMax（视频 AI 解析/打标）──────────────
# 在 https://api.minimaxi.com/ 控制台申请
MINIMAX_API_KEY=<your-minimax-api-key>
MINIMAX_BASE=https://api.minimaxi.com/v1

# ── 豆包 TTS（火山引擎）────────────────────
# 在火山引擎控制台 https://console.volcengine.com/ 申请
DOUBAO_CLIENT_ID=<your-doubao-client-id>
DOUBAO_CLIENT_SECRET=<your-doubao-client-secret>
DOUBAO_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v1/mt_tts

# ── 飞书多维表格（数据源）─────────────────
# 在飞书开放平台 https://open.feishu.cn/ 创建应用后获取
FEISHU_APP_ID=<your-feishu-app-id>
FEISHU_APP_SECRET=<your-feishu-app-secret>
FEISHU_BITABLE_APP_TOKEN=<your-bitable-app-token>
FEISHU_TABLE_ID=<shot-table-id>
FEISHU_MAIN_TABLE_ID=<main-video-table-id>
FEISHU_NEW_VIDEO_TABLE_ID=<new-video-table-id>
FEISHU_USER_TABLE_ID=<user-account-table-id>
FEISHU_BASE=https://open.feishu.cn

# ── 视频文件存储路径 ─────────────────────────
# Railway 部署时建议改为 /app/uploads 或 /tmp/zhongli-videos
VIDEO_UPLOAD_DIR=/tmp/zhongli-videos

# ── 阿里云 OSS（视频云端存储）──────────────
# 在阿里云控制台 https://ram.console.aliyun.com/manage/ak 获取
ALI_OSS_ACCESS_KEY_ID=<your-aliyun-access-key-id>
ALI_OSS_ACCESS_KEY_SECRET=<your-aliyun-access-key-secret>
ALI_OSS_BUCKET=<your-bucket-name>
ALI_OSS_REGION=<your-region-eg-oss-cn-hangzhou>
ALI_OSS_ENDPOINT=
ALI_OSS_PREFIX=videos/
ALI_OSS_PUBLIC_READ=true

# ── 数据库 ───────────────────────────────────
# Railway 部署时用 Postgres，DATABASE_URL 由 Railway Postgres 插件自动注入
# 本地开发用 PGlite 嵌入式
DATABASE_URL=pglite://./data/pglite
DATABASE_DRIVER=pglite

# ── 部署相关 ──────────────────────────────────
# Railway 自动设置 PORT 环境变量
# 客户端静态资源路径（生产环境 = NestJS 服务的静态托管路径）
NODE_ENV=production
